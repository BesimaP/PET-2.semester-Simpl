@startuml
!pragma layout smetana

title UC10: LogMedication

actor "Patient" as u
participant "MedicationLogView" as v
participant "MedicationLogController" as c
participant "Medication / MedicationLog" as m
database "SQLite" as db

u -> v : Opens medication screen
v -> c : loadLogs(roundId)
c -> db : SELECT ml.*, m.name FROM medication_log ml JOIN medication m ON ml.medication_id = m.id WHERE ml.round_id = ? ORDER BY scheduled_date_time
db --> c : ResultSet
c --> v : showLogs(list)
v --> u : Shows checklist with name, dose, time, taken

u -> v : Clicks Tilføj Medicin
v -> c : loadMedications()
c -> db : SELECT * FROM medication
db --> c : ResultSet
v --> u : Shows dropdown of medications (or "create new")

u -> v : Selects medication, fills in dose, unit, scheduled time
u -> v : Clicks Gem
v -> c : handleAddLog(medicationId, dose, unit, scheduledDateTime)

alt Required fields empty
  c --> v : showError()
  v --> u : "Please fill in all fields"
else New medication chosen
  c -> m : new Medication(name, description)
  c -> db : INSERT INTO medication (name, description) VALUES (?, ?)
  db --> c : OK (medicationId)
  c -> m : new MedicationLog(scheduledDateTime, dose, unit, taken=false, medicationId, roundId)
  c -> db : INSERT INTO medication_log (round_id, medication_id, scheduled_date_time, dose, unit, taken) VALUES (?, ?, ?, ?, ?, 0)
  db --> c : OK
  c --> v : refreshList()
else Existing medication
  c -> m : new MedicationLog(scheduledDateTime, dose, unit, taken=false, medicationId, roundId)
  c -> db : INSERT INTO medication_log (round_id, medication_id, scheduled_date_time, dose, unit, taken) VALUES (?, ?, ?, ?, ?, 0)
  db --> c : OK
  c --> v : refreshList()
  v --> u : Shows updated checklist
end

== Mark as taken ==
u -> v : Ticks a dose
v -> c : handleMarkTaken(logId)
c -> db : UPDATE medication_log SET taken = 1 WHERE id = ?
db --> c : OK
c --> v : refreshList()
v --> u : Dose shown as taken

@enduml
