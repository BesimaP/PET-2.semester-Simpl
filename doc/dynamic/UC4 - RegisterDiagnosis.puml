@startuml
!pragma layout smetana

title UC4: RegisterDiagnosis

actor "Patient" as u
participant "DiagnosisView" as v
participant "DiagnosisController" as c
participant "Diagnosis" as m
database "SQLite" as db

u -> v : Opens diagnosis screen
v -> c : loadDiagnoses(patientId)
c -> db : SELECT * FROM diagnosis WHERE patient_id = ?
db --> c : ResultSet
c --> v : showDiagnoses(list)
v --> u : Shows registered diagnoses

u -> v : Clicks Tilføj Diagnose, fills in name and description
u -> v : Clicks Gem
v -> c : handleAddDiagnosis(name, description)

alt Name is empty
  c --> v : showError()
  v --> u : "Name is required"
else All OK
  c -> m : new Diagnosis(name, description, patientId)
  c -> db : INSERT INTO diagnosis (patient_id, name, description) VALUES (?, ?, ?)
  db --> c : OK
  c --> v : refreshList()
  v --> u : Shows updated list
end

@enduml
