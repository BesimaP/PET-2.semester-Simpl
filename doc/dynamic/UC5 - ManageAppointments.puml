@startuml
!pragma layout smetana

title UC5: ManageAppointments

actor "Patient" as u
participant "AppointmentView" as v
participant "AppointmentController" as c
participant "Appointment" as m
database "SQLite" as db

u -> v : Opens appointments screen
v -> c : loadAppointments(journeyId)
c -> db : SELECT * FROM appointment WHERE journey_id = ? AND date_time >= now ORDER BY date_time ASC
db --> c : ResultSet
c --> v : showAppointments(list)
v --> u : Shows upcoming appointments, nearest first

u -> v : Clicks Tilføj Aftale, fills in dateTime, type, location
u -> v : Clicks Gem
v -> c : handleAddAppointment(dateTime, type, location)

alt Required fields empty
  c --> v : showError()
  v --> u : "Please fill in all fields"
else Date is in the past
  c --> v : showConfirm()
  v --> u : "Date is in the past - save anyway?"
  u -> v : Confirms
  v -> c : confirmAdd()
  c -> m : new Appointment(dateTime, type, location, journeyId)
  c -> db : INSERT INTO appointment (journey_id, date_time, type, location) VALUES (?, ?, ?, ?)
  db --> c : OK
  c --> v : refreshList()
else All OK
  c -> m : new Appointment(dateTime, type, location, journeyId)
  c -> db : INSERT INTO appointment (journey_id, date_time, type, location) VALUES (?, ?, ?, ?)
  db --> c : OK
  c --> v : refreshList()
  v --> u : Shows updated list
end

@enduml
