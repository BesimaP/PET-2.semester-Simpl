@startuml
!pragma layout smetana

title UC2: ManageProfile

actor "Patient" as u
participant "ProfileView" as v
participant "ProfileController" as c
participant "UserAccount / Patient" as m
database "SQLite" as db

u -> v : Clicks "Opret profil"
v --> u : Shows form: name, dateOfBirth, username, password

u -> v : Fills in fields
u -> v : Clicks Gem
v -> c : handleCreateProfile(name, dateOfBirth, username, password)

alt Required fields empty
  c --> v : showError()
  v --> u : "Please fill in all fields"
else Fields filled
  c -> db : SELECT id FROM user_account WHERE username = ?
  db --> c : ResultSet
  alt Username already taken
    c --> v : showError()
    v --> u : "Username is already in use"
  else Username free
    c -> c : passwordHash = hash(password)
    c -> m : new UserAccount(username, passwordHash)
    c -> db : INSERT INTO user_account (username, password_hash) VALUES (?, ?)
    db --> c : OK (id)
    c -> m : new Patient(name, dateOfBirth, userAccountId)
    c -> db : INSERT INTO patient (name, date_of_birth, user_account_id) VALUES (?, ?, ?)
    db --> c : OK
    c --> v : showCreateJourney()
    v --> u : Shows "Start nyt forløb" (UC3)
  end
end

== Edit profile (logged in) ==
u -> v : Changes name / dateOfBirth, clicks Gem
v -> c : handleUpdateProfile(name, dateOfBirth)
c -> db : UPDATE patient SET name = ?, date_of_birth = ? WHERE id = ?
db --> c : OK
v --> u : "Profile updated"

== Delete account (logged in) ==
u -> v : Clicks "Slet konto"
v --> u : Shows confirmation dialog
u -> v : Confirms
v -> c : handleDeleteAccount()
c -> db : DELETE FROM patient WHERE id = ? (cascade to journeys, rounds, logs, documents, notifications)
db --> c : OK
c -> db : DELETE FROM user_account WHERE id = ?
db --> c : OK
c --> v : showLogin()
v --> u : Shows login screen

@enduml
