@startuml
!pragma layout smetana

title UC9: LogHormoneValue

actor "Patient" as u
participant "HormoneLogView" as v
participant "HormoneLogController" as c
participant "HormoneLog" as m
database "SQLite" as db

u -> v : Opens hormone screen
v -> c : loadValues(roundId)
c -> db : SELECT * FROM hormone_log WHERE round_id = ? ORDER BY date_time DESC
db --> c : ResultSet
c --> v : showValues(list, latest)
v --> u : Shows values with latest highlighted

u -> v : Clicks Tilføj Værdi, fills in hormoneType, value, unit, date
u -> v : Clicks Gem
v -> c : handleAddValue(hormoneType, value, unit, dateTime)

alt Value is not a number
  c --> v : showError()
  v --> u : "Value must be a number"
else All OK
  c -> m : new HormoneLog(dateTime, hormoneType, value, unit, roundId)
  c -> db : INSERT INTO hormone_log (round_id, date_time, hormone_type, value, unit) VALUES (?, ?, ?, ?, ?)
  db --> c : OK
  c --> v : refreshList()
  v --> u : Shows updated list
end

@enduml
