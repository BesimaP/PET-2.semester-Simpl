@startuml
!pragma layout smetana

actor "Patient" as u

usecase "UC1: StartSystem" as UC1
usecase "UC2: ManageProfile" as UC2
usecase "UC3: CreateJourney" as UC3
usecase "UC4: Diagnosis" as UC4
usecase "UC5: Appointment" as UC5
usecase "UC6: Diary" as UC6
usecase "UC7: Notification" as UC7

rectangle "Round (fertilitetsrunde)" {
  usecase "UC8: NewRound" as UC8
  usecase "UC9: HormoneLog" as UC9
  usecase "UC10: MedicationLog" as UC10
  usecase "UC11: Timeline" as UC11
  usecase "UC12: Document" as UC12
  usecase "UC13: RoundHistory" as UC13
  usecase "UC14: EndRound" as UC14
}

u --> UC1

UC1 --> UC2
UC1 --> UC3
UC2 --> UC3
UC3 --> UC4
UC3 --> UC5
UC3 --> UC6
UC3 --> UC7
UC3 --> UC8
UC8 --> UC9
UC8 --> UC10
UC8 --> UC11
UC8 --> UC12
UC8 --> UC13
UC8 --> UC14

note bottom of UC14
  Efter afsluttet runde kan
  patienten starte en ny runde
  under samme forløb (UC8)
end note

@enduml