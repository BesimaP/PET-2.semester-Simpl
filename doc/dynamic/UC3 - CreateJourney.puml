@startuml
!pragma layout smetana

title UC3: CreateJourney

actor "Patient" as u
participant "CreateJourneyView" as v
participant "JourneyController" as c
participant "FertilityJourney" as m
database "SQLite" as db

u -> v : Shown after login/profile creation
v --> u : Shows "Start nyt forløb"

u -> v : Clicks Start nyt forløb
v -> c : handleCreateJourney(patientId)
c -> db : SELECT id FROM fertility_journey WHERE patient_id = ? AND status = 'ACTIVE'
db --> c : ResultSet

alt Active journey already exists
  c --> v : showError()
  v --> u : "Afslut dit aktive forløb først"
else No active journey
  c -> m : new FertilityJourney(patientId, today, ACTIVE)
  c -> db : INSERT INTO fertility_journey (patient_id, start_date, status) VALUES (?, ?, 'ACTIVE')
  db --> c : OK (id)
  c -> c : Session.setJourney(journey)
  c --> v : showDashboard()
  v --> u : Shows dashboard
end

alt Database error
  c --> v : showError()
  v --> u : "Could not create journey"
end

@enduml
