@startuml
!pragma layout smetana

title Domain Model - Patient Journey

object "<b>Patient</b>" as Patient #FFDAB9

object "<b>Journey</b>" as Journey #D6EAD8

object "<b>FertilityJourney</b>" as FertilityJourney #C1E8C1 {
  roundNumber
  eggsRetrieved
  eggsFertilised
  result
}
object "<b>CancerJourney</b>" as CancerJourney #C1E8C1 {
  cancerType
  stage
}
object "<b>RehabilitationJourney</b>" as RehabilitationJourney #C1E8C1 {
  injuryType
  goal
}
object "<b>PsychiatryJourney</b>" as PsychiatryJourney #C1E8C1 {
  condition
}
object "<b>OtherJourney</b>" as OtherJourney #C1E8C1 {
  description
}

object "<b>Event</b>" as Event #FFF3B0 {
  date
  type
  description
}
object "<b>Appointment</b>" as Appointment #FFF3B0 {
  date
  type
  location
  completed
}
object "<b>MedicationLog</b>" as MedicationLog #FFF3B0 {
  date
  medication
  dose
  taken
}
object "<b>DiaryEntry</b>" as DiaryEntry #FFF3B0 {
  date
  title
  content
}
object "<b>HormoneLog</b>" as HormoneLog #FFF3B0 {
  date
  hormone
  value
  unit
}

object "<b>Status</b>" as Status #E3D5F0 {
  ACTIVE
  COMPLETED
  PAUSED
}
object "<b>Result</b>" as Result #E3D5F0 {
  POSITIVE
  NEGATIVE
  PENDING
}
object "<b>EventType</b>" as EventType #E3D5F0 {
  CONSULTATION
  EXAMINATION
  STIMULATION
  EGG_RETRIEVAL
  FERTILISATION
  TRANSFER
  PREGNANCY_TEST
  OTHER
}
object "<b>AppointmentType</b>" as AppointmentType #E3D5F0 {
  SCANNING
  CONSULTATION
  EGG_RETRIEVAL
  TRANSFER
  BLOOD_TEST
  OTHER
}

Patient : name
Patient : dateOfBirth
Patient : diagnosis
Patient : username
Patient : password

Journey : startDate
Journey : status

' Inheritance
FertilityJourney --|> Journey
CancerJourney --|> Journey
RehabilitationJourney --|> Journey
PsychiatryJourney --|> Journey
OtherJourney --|> Journey

' Has a
Patient "1" *-- "1..*" Journey : has a
Journey "1" *-- "0..*" Event : has a
Journey "1" *-- "0..*" Appointment : has a
Journey "1" *-- "0..*" MedicationLog : has a
Journey "1" *-- "0..*" DiaryEntry : has a
FertilityJourney "1" *-- "0..*" HormoneLog : has a

' Is a
Journey "1" -- "1" Status : is a
FertilityJourney "1" -- "1" Result : is a
Event "1" -- "1" EventType : is a
Appointment "1" -- "1" AppointmentType : is a

@enduml